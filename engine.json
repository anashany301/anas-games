{
  "infinite_autonomous_game_engine": {
    "engine_version": "10.0.0",
    "status": "ready_for_index_integration",
    "target_device": "Low-spec Mobile & Desktop (Snapdragon 450 / A20s)",
    "offline_support": true,
    
    "device_auto_detector": {
      "concept": "كشف تلقائي لنوع الجهاز وتغيير الواجهة والتحكم بناءً عليه فوراً",
      "detection_script": "const isMobile = /Mobi|Android|iPhone/i.test(navigator.userAgent);",
      "desktop_adaptation": {
        "screen_orientation": "fullscreen",
        "virtual_touch_buttons": "hidden",
        "active_controls": ["keyboard", "mouse"]
      },
      "mobile_adaptation": {
        "screen_orientation": "force_landscape",
        "virtual_touch_buttons": "visible_overlay",
        "active_controls": ["touch"]
      }
    },

    "priority_featured_classics": [
      {
        "id": 0,
        "name": "ماريو كلاسيك (Mario 2D)",
        "type": "فردية",
        "category": "منصات ومغامرات",
        "color": "#E52521",
        "description": "منصات أصلية بيكسل وتحكم كامل"
      },
      {
        "id": 1,
        "name": "تيكن القتالية (Tekken 2D)",
        "type": "جماعية / ثنائية",
        "category": "قتال أركيد",
        "color": "#FF4500",
        "description": "قتال ثنائي أركيد سريع"
      }
    ],

    "smart_distribution_and_type_classifier": {
      "ratios": {
        "single_player_percentage": 90,
        "multiplayer_percentage": 10,
        "multi_part_saga_percentage_of_single": 5,
        "max_saga_parts": 6
      },
      "arabic_prefixes": ["مغامرة", "أسطورة", "تحدي", "بطولة", "حروب", "معركة", "سرعة", "لغز"],
      "arabic_suffixes": ["الفضاء", "الصحراء", "المدينة", "المقاتلين", "المتاهة", "العمالقة", "الزمن", "الأبطال"],
      
      "generator_logic": "function generateGame(seed) { if(seed === 0 || seed === 1) return engine.priority_featured_classics[seed]; let p = engine.smart_distribution_and_type_classifier.arabic_prefixes[seed % engine.smart_distribution_and_type_classifier.arabic_prefixes.length]; let s = engine.smart_distribution_and_type_classifier.arabic_suffixes[(seed * 3) % engine.smart_distribution_and_type_classifier.arabic_suffixes.length]; let typeRoll = seed % 100; let type = typeRoll < 90 ? 'فردية (مستقلة)' : 'جماعية (ثنائية)'; return { id: seed, name: `${p} ${s} #${seed} [${type}]`, type: type, color: '#4CAF50', description: 'لعبة مولدة برمجياً - اضغط للفتح الفوري' }; }"
    },

    "pixel_and_graphics_renderer": {
      "engine": "HTML5_Canvas_Lightweight_PixelMap",
      "auto_scale_resolution": "fit_screen_without_lag"
    },

    "sound_and_effects_engine": {
      "system": "Web_Audio_API_Synthesizer",
      "effects_mapping": {
        "jump": { "frequency": 440, "duration": 0.1, "type": "square" },
        "hit": { "frequency": 150, "duration": 0.3, "type": "sawtooth" },
        "coin": { "frequency": 880, "duration": 0.1, "type": "sine" }
      }
    },

    "universal_input_manager": {
      "keyboard_mapping": {
        "movement": { "left": ["ArrowLeft", "KeyA"], "right": ["ArrowRight", "KeyD"] },
        "actions": { "jump": ["Space", "ArrowUp", "KeyW"] }
      },
      "touch_screen_overlay": {
        "controls": ["btn-left", "btn-right", "btn-action"]
      }
    }
  }
}
